{
  "name": "react-render-wave",
  "version": "3.1.0",
  "description": "Progressive wave rendering and lightweight virtual scrolling for React lists.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.es.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo": "vite demo --open",
    "prepublishOnly": "npm run test && npm run build && npm run check:pkg",
    "check:pkg": "publint && attw --pack ."
  },
  "keywords": [
    "react",
    "hooks",
    "virtual-scroll",
    "virtualization",
    "progressive-rendering",
    "windowing",
    "performance"
  ],
  "author": "sudo-ezekiel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudo-ezekiel/react-render-wave.git"
  },
  "homepage": "https://github.com/sudo-ezekiel/react-render-wave#readme",
  "bugs": {
    "url": "https://github.com/sudo-ezekiel/react-render-wave/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@microsoft/api-extractor": "^7.59.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "jsdom": "^26.1.0",
    "publint": "^0.3.24",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^3.1.3"
  }
}
